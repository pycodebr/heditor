#!/usr/bin/env bash
# heditor command-line helper. Run `heditor help`.
set -euo pipefail
HEDITOR_HOME="${HEDITOR_HOME:-$HOME/.heditor}"
SKILL_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
if [[ -f "$HEDITOR_HOME/env.sh" ]]; then . "$HEDITOR_HOME/env.sh"; fi
KIT="$SKILL_DIR/scripts/reelkit"
# build.py/prepare.py import the kit through HEDITOR_KIT: always point it at the kit next to this script, so a
# second checkout (a branch, a fork) never mixes its CLI with another checkout's kit from env.sh.
export HEDITOR_KIT="$KIT" HEDITOR_SKILL="$SKILL_DIR"
PY="${HEDITOR_PY:-$HEDITOR_HOME/venv/bin/python}"
HF="${HEDITOR_HYPERFRAMES:-npx --yes hyperframes@0.9.13}"
cmd="${1:-help}"; shift || true

need_work() { [[ -n "${1:-}" ]] || { echo "usage: heditor $cmd <work_dir> ..."; exit 2; }; }

case "$cmd" in
  setup)   bash "$SKILL_DIR/scripts/setup.sh" "$@" ;;
  doctor)  "$PY" "$SKILL_DIR/scripts/doctor.py" ;;
  new)     # heditor new <work_dir> <source_video> [--style nativo]   |   heditor new --long <work> <video> [--format 16:9] [--style X]
           if [[ " $* " == *" --long "* ]]; then
             args=(); for a in "$@"; do [[ "$a" == "--long" ]] || args+=("$a"); done
             exec "$PY" "$KIT/long_cli.py" new "${args[@]}"
           fi
           STYLE=""; pos=()
           while [[ $# -gt 0 ]]; do case "$1" in --style) STYLE="${2:-}"; shift 2 ;; *) pos+=("$1"); shift ;; esac; done
           set -- "${pos[@]}"
           need_work "${1:-}"; W="$(mkdir -p "$1" && cd "$1" && pwd)"; SRC="${2:-}"
           mkdir -p "$W/qa" "$W/composition"
           [[ -e "$W/composition/package.json" ]] || cp "$SKILL_DIR/templates/composition-package.json" "$W/composition/package.json"
           # A style with a reference implementation (templates/styles/<slug>/) seeds build.py/DESIGN.md from it.
           for f in prepare.py build.py DESIGN.md; do
             src="$SKILL_DIR/templates/$f"; [[ -n "$STYLE" && -e "$SKILL_DIR/templates/styles/$STYLE/$f" ]] && src="$SKILL_DIR/templates/styles/$STYLE/$f"
             [[ -e "$W/$f" ]] || cp "$src" "$W/$f"
           done
           [[ -n "$SRC" ]] && sed -i.bak "s#^SOURCE = .*#SOURCE = \"$(readlink -f "$SRC")\"#" "$W/prepare.py" && rm -f "$W/prepare.py.bak"
           echo "created $W (edit prepare.py BLOCKS, then: heditor prepare $W)" ;;
  probe)   # heditor probe <source_video> [seconds...]  -> frames to locate the speaker/camera
           SRC="$1"; shift; OUT="${PROBE_DIR:-./probe}"; mkdir -p "$OUT"
           ffprobe -v error -show_entries format=duration:stream=width,height,r_frame_rate -of compact "$SRC"
           for t in "${@:-5 30 60}"; do ffmpeg -v error -y -ss "$t" -i "$SRC" -frames:v 1 "$OUT/frame-$t.jpg"; echo "$OUT/frame-$t.jpg"; done ;;
  transcribe) # heditor transcribe <source_video> <start_s> <duration_s> <out.json> [prompt]
           "$PY" "$KIT/asr_window.py" "$@" ;;
  prepare) need_work "${1:-}"; (cd "$1" && "$PY" prepare.py) ;;
  words)   need_work "${1:-}"; "$PY" "$KIT/transcribe_cut.py" "$@" ;;
  gaps)    # heditor gaps <work_dir> [max_gap_s] [min_report_s] -> dead air left in the assembled voice
           need_work "${1:-}"; "$PY" "$KIT/gaps.py" "$@" ;;
  produce) # heditor produce <work_dir> <music:ID|track.mp3> <drop_s>
           need_work "${1:-}"; "$PY" "$KIT/produce.py" "$@" ;;
  lint)    need_work "${1:-}"; (cd "$1/composition" && $HF lint) ;;
  preview) # heditor preview <work_dir> <t1,t2,...> [sheet.jpg]   (times may also be separate args: 0 0.5 2 ...)
           need_work "${1:-}"; work="$1"; shift; sheet="sheet.jpg"; times=()
           for a in "$@"; do case "$a" in *.jpg|*.jpeg|*.png) sheet="$a" ;; *) times+=("$a") ;; esac; done
           [[ ${#times[@]} -gt 0 ]] || { echo "usage: heditor preview <work_dir> <t1,t2,...> [sheet.jpg]"; exit 2; }
           tl="$(IFS=,; echo "${times[*]}")"; "$PY" "$KIT/preview.py" "$sheet" "${tl//,,/,}" "$work" ;;
  test)    need_work "${1:-}"; CUT_WORK="$(cd "$1" && pwd)" "$PY" -m pytest -q "$KIT/test_cut.py" ;;
  render)  # heditor render <work_dir> [workers]
           need_work "${1:-}"; mkdir -p "$1/render"
           export FFMPEG_ENCODE_TIMEOUT_MS="${FFMPEG_ENCODE_TIMEOUT_MS:-3600000}"   # heavy styles on busy machines; set PRODUCER_ENABLE_CHUNKED_ENCODE=true if it still times out
           (cd "$1/composition" && $HF render --fps 30 --quality high --crf 17 --workers "${2:-2}" --strict --no-best-effort --output ../render/render.mp4) ;;
  finalize) # heditor finalize <work_dir> <final_name.mp4> [auto|t1,t2,...]
           need_work "${1:-}"; "$PY" "$KIT/finalize.py" "$1" "$2" "${3:-auto}" ;;
  asr-check) need_work "${1:-}"; "$PY" "$KIT/asr_check.py" "$1" ;;
  music)   # heditor music <music:ID|track.mp3> [out.json] -> tempo, energy, kick entries, breakdowns, lifts
           "$PY" "$KIT/music_profile.py" "$@" ;;
  matte|depth|look|hands|plane) # layered / 2.5D helpers (depthkit); see references/depth-and-3d.md
           [[ "$cmd" == plane ]] || need_work "${1:-}"; "$PY" "$KIT/layers.py" "$cmd" "$@" ;;
  capture) # heditor capture <url> <out.png> [--desktop] [--dark] [--viewport] [...] -> page screenshot (style reacao)
           "$PY" "$KIT/reacaokit.py" capture "$@" ;;
  region)  # heditor region <work> <name> <crop=w:h:x:y> [filters] -> a region of the source cut with the cut's EDL
           need_work "${1:-}"; "$PY" "$KIT/reacaokit.py" region "$@" ;;
  triage)  # heditor triage <video...> [--out DIR] [--model large-v3] [--lang pt] [--forbid a,b] [--no-tech] -> raw-take report
           "$PY" "$KIT/triage.py" "$@" ;;
  splice)  # heditor splice find-cut <video> <a> <b>  |  heditor splice <opening_work> <body.mp4> <out.mp4> [--cut-frame K]
           "$PY" "$KIT/splice.py" "$@" ;;
  study)   # heditor study <video> [--out DIR] [--every 2] | heditor study compare <ref.json> <yours.json>
           # reference study with HyperFrames' local measure/audio tools (references/reference-study.md)
           "$PY" "$KIT/studykit.py" "$@" ;;
  svg)     # heditor svg <in.svg> [out.svg] [static|draw|morph] -> SVGO clean-up + visual check (references/gsap-craft.md)
           "$PY" "$KIT/svgkit.py" "$@" ;;
  physics) # heditor physics <work> <scene.json> [name] -> baked rigid-body sim (references/physics-3d.md)
           need_work "${1:-}"; "$PY" "$KIT/physkit.py" "$@" ;;
  stock)   # heditor stock search "<query>" [...] | heditor stock get <work> <#n|ref|url>  (Mixkit, no key)
           "$PY" "$KIT/stockkit.py" "$@" ;;
  heygen)  # optional: heditor heygen connect|status|disconnect|avatars|voices|glossaries (references/heygen-avatar.md)
           "$PY" "$KIT/heygenkit.py" "$@" ;;
  gen)     # optional: heditor gen status|persona|clip|talk|resume (references/generation.md)
           "$PY" "$KIT/genkit.py" "$@" ;;
  avatar)  # optional: heditor avatar <work> --look ID (--script F|--text T|--audio F) [...] -> AI avatar source video
           need_work "${1:-}"; "$PY" "$KIT/heygenkit.py" avatar "$@" ;;
  styles)  ls "$SKILL_DIR/references/styles" | sed 's/\.md$//' | grep -v INDEX ;;
  formats) "$PY" "$KIT/long_cli.py" formats ;;
  long)    # long-form pipeline (classes, lives, YouTube) in any format profile; see references/long-form.md
           "$PY" "$KIT/long_cli.py" "$@" ;;
  help|*)  cat <<EOF
heditor - creative video editing for AI agents (vertical Reels and long-form videos in any format)

  heditor setup [--no-audio] [--whisper small,medium]   install tools + assets (idempotent)
  heditor doctor                                         check the environment
  heditor styles                                         list the named styles
  heditor probe <video> [t...]                           frames to locate the speaker/camera
  heditor transcribe <video> <start> <dur> <out.json>    word-timed ASR of a window (use 0 and full length for all)
  heditor triage <video...> [--out DIR] [--lang pt] [--forbid "a,b"] [--no-tech]
                                                         raw takes: chunks between silences transcribed alone and
                                                         labelled keep / retake / false_start / editor / noise, asides
                                                         to the editor with intent, stumbles, recording failures
  heditor new <work> [video] [--style nativo|reacao|...] scaffold a cut (prepare.py, build.py, DESIGN.md)
  heditor prepare <work>                                 cut speech + camera from the source (runs prepare.py)
  heditor words <work> [prompt]                          ASR of the assembled cut -> words.json/words-reviewed.json
  heditor gaps <work> [max_s]                            dead air left in the cut (fails if a pause > 0.45 s)
  heditor produce <work> <music:ID|file> <drop_s>        build composition + mix (profile voice|presence; runs build.py)
  heditor lint <work>                                    HyperFrames lint (must be 0 errors)
  heditor preview <work> <t1,t2,...> [sheet.jpg]         frame previews + contact sheet in <work>/qa
  heditor test <work>                                    integrity tests (captions, CTA, balance, numbers)
  heditor render <work> [workers]                        render MP4 with HyperFrames
  heditor finalize <work> <name.mp4>                     mux master audio + verification + 40-frame sheet
  heditor asr-check <work>                               ASR of final mix vs clean voice (masking check, MASKED spans; exit 1 on fail)
  heditor music <music:ID|file> [out.json]               track profile: bpm, energy/s, kick entries, breakdowns, lifts

Hook tests on a video that is already delivered (see references/hook-variants.md):
  heditor splice find-cut <video> <from_s> <to_s>        first black frame / picture jumps / audio level: the splice point
  heditor splice <opening_work> <body.mp4> <out.mp4> [--cut-frame K] [--overlay seal.png --overlay-until S]
                 [--xfade-ms 8] [--no-match]             new opening + the delivered body from frame K, body untouched

Reference study: derive a style from videos someone wants to emulate (see references/reference-study.md):
  heditor study <video> [--out DIR] [--every 2] [--no-audio] [--no-face] [--no-frames]
                                                         cuts, shots, on-screen events, holds, sound onsets, loudness,
                                                         silences, look and face size measured locally by HyperFrames
                                                         -> study.json + study.md + overview sheets (no sign-in, no credits)
  heditor study compare <reference/study.json> <yours/study.json>
                                                         a pilot's rhythm and look next to the reference's

Formats and long form (classes, lives, YouTube; see references/long-form.md):
  heditor formats                                        format profiles (9:16, 16:9, 16:9-4k, 1:1, 4:5)
  heditor new --long <work> <video> [--format 16:9] [--style X] [--kind aula|live|youtube] [--range a,b]
  heditor long transcribe|edl|apply|chapters|layouts|produce|lint|preview|render|finalize|qa|subs|sync|estimate|styles <work> ...
                                                         run `heditor long help` for every subcommand

Layered / 2.5D (depthkit, see references/depth-and-3d.md):
  heditor matte <work> [multiclass|selfie]               speaker alpha: camera-alpha.webm + matte-person.mp4
  heditor depth <work> [fps]                             relative depth map: depth.mp4 + depth-still.png
  heditor look <work> fog|edges|edges-rgb|dots [#hex]     depth fog, contour scan, edge scan, point cloud
  heditor hands <work> [t0] [t1]                         hand landmarks -> qa/hands-<t0>.json
  heditor plane <w> <h> x1,y1 x2,y2 x3,y3 x4,y4           CSS matrix3d pinning a w x h element onto 4 points

Backdrops for the style reacao (the speaker in front of the post; see references/styles/reacao.md):
  heditor capture <url> <out.png> [--desktop] [--dark] [--viewport] [--width N] [--height N] [--scale S]
                  [--wait s] [--selector CSS] [--hide CSS,CSS]   screenshot of a public page (full page by default)
  heditor region <work> <name> <crop=w:h:x:y> [filters]  the post inside the raw recording, same EDL -> bd-<name>.mp4

Stock video / B-roll from Mixkit (free licence, no account or key; see references/stock-media.md):
  heditor stock search "<english words>" [--orientation portrait|landscape|square] [--limit N] [--page N] [--json]
                                                         numbered clips with orientation and page URL
  heditor stock get <work> <#n|mixkit:video:ID|page-url> [--quality 1080|4k|best|720] [--as name]
                                                         licence checked on the page, file into
                                                         <work>/composition/assets/stock, provenance in <work>/stock.json

AI avatar from your HeyGen account (optional; nothing else needs it; see references/heygen-avatar.md):
  heditor heygen connect [--oauth|--remote|--api-key]    interactive, by the account owner: HeyGen account (OAuth,
                                                         subscription credits) or API key (API wallet); installs the
                                                         official HeyGen CLI if asked; heditor never sees the key
  heditor heygen status [--json]                         connection, billing mode, plan, credits or balance
  heditor heygen avatars|voices [--json]                 your avatar looks (ids, engines) and cloned voices
  heditor heygen glossaries [--json]                     pronunciation glossaries (term -> respelling) for scripts
  heditor heygen disconnect [--yes]                      remove the stored HeyGen credential
  heditor avatar <work> --look ID (--script FILE|--text "..."|--audio FILE) [--voice ID] [--engine v|iv|iii]
                 [--glossary ID] [--speed 0.5-1.5] [--aspect 9:16] [--resolution 1080p] [--motion "..."]
                 [--dry-run] [--yes]
                                                         cost estimate + confirmation, render, download into
                                                         <work>/source, provenance in <work>/avatar.json
  heditor avatar <work> --resume VIDEO_ID                download a video that was still rendering
Generated media from your HeyGen account (optional; references/generation.md):
  heditor gen status                                     credits left and the measured cost of each kind of job
  heditor gen persona <work> <name> --ref IMG [--n 1]    you inside the reference image's scene, pose and clothes
  heditor gen clip <work> <name> --prompt "..." [--image IMG|--ref IMG..] [--seconds 5] [--res 480p]
                                                         a generated scene with its own sound (text/image/references)
  heditor gen talk <work> <name> --image IMG (--text "..."|--script F|--audio F) [--motion ".."] [--alpha]
                                                         any image of you speaking (cloned voice or your recording)
  heditor gen resume <work> <job_id>                     download a job that was still rendering
  (every command prints the plan and the estimate; nothing is spent without --yes)

Motion assets (see references/gsap-craft.md and references/physics-3d.md):
  heditor svg <in.svg> [out.svg] [static|draw|morph]     SVGO clean-up for DrawSVG/MorphSVG + visual diff check
  heditor physics <work> <scene.json> [name]             bake a Rapier rigid-body sim -> assets/physics-<name>.js
EOF
  ;;
esac
